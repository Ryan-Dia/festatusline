{
  "name": "festatusline",
  "version": "0.16.0",
  "description": "Customizable Claude Code statusline with i18n (ko/en/zh), themes, and multi-CLI usage widgets.",
  "type": "module",
  "bin": {
    "festatusline": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "ink": "^8.0.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --fix"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.4"
  }
}
